---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
  <Navbar />

  <section class="container">
    <h1>Certifications</h1>
    
    <div class="certs-grid">
      <a href="https://portswigger.net/web-security/e/c/c937cdd4ba83d7a7" target="_blank" rel="noopener noreferrer" class="cert-card bscp-card">
        <img src="/images/BSCP.png" alt="BSCP" style="object-fit: contain; border-radius: 16px;" />
      </a>

      <a href="#" class="cert-card">
        <img src="/images/CPTS.jpeg" alt="CPTS" />
      </a>
      <a href="#" class="cert-card">
        <img src="/images/cjca.png" alt="CJCA" />
      </a>

      <a href="#" class="cert-card">
        <img src="/images/thm1.png" alt="THM" />
      </a>

      <a href="#" class="cert-card">
        <img src="/images/udemi.png" alt="UDEMY" />
      </a>

      <a href="#" class="cert-card">
        <img src="/images/udemy2.png" alt="UDEMY" />
      </a>

      <a href="#" class="cert-card cisco-card">
        <img src="/images/cisco.png" alt="CISCO" style="object-fit: contain; border-radius: 16px;"/>
      </a>
    </div>
  </section>

  <style>
    .certs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    @media (max-width: 768px) {
      .certs-grid {
        gap: 1rem;
      }
    }

    .cert-card {
      background: var(--card);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid #1f2937;
      transition: all 0.3s ease, opacity 0.8s ease, filter 0.8s ease;
      text-decoration: none;
      display: block;
      aspect-ratio: 1.4 / 1;
      opacity: 0;
      filter: blur(12px);
    }

    .cert-card.in-view {
      opacity: 1;
      filter: blur(0);
    }

    .cert-card:hover {
      transform: translateY(-5px);
      border-color: var(--accent);
      box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
    }

    @media (prefers-reduced-motion: reduce) {
      .cert-card {
        opacity: 1;
        filter: none;
        transition: all 0.3s ease;
      }
    }

    .cert-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cisco-card,
    .bscp-card {
      background: #ffffff;
    }

    .cisco-card:hover,
    .bscp-card:hover {
      border-color: var(--accent);
      box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
    }
  </style>

  <script>
    const items = document.querySelectorAll('.cert-card');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('in-view', entry.isIntersecting);
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -60px 0px' }
    );

    for (const item of items) {
      observer.observe(item);
    }
  </script>
</Layout>